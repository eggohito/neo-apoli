{
	"schemaVersion": 1,
	"id": "neo-apoli",
	"version": "${version}",
	"name": "Neo-Apoli",
	"description": "A rewrite of https://github.com/apace100/apoli that provides more functionality and flexibility ",
	"authors": [
		"eggohito"
	],
	"contact": {
		"sources": "https://github.com/eggohito/neo-apoli"
	},
	"license": "MIT",
	"icon": "assets/neo-apoli/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.eggohito.neo_apoli.NeoApoli"
		],
		"client": [
			"io.github.eggohito.neo_apoli.NeoApoliClient"
		],
		"modmenu": [
			"io.github.eggohito.neo_apoli.client.integration.ModMenuIntegration"
		]
	},
	"mixins": [
		"neo-apoli.mixins.json",
		{
			"environment": "client",
			"config": "neo-apoli.mixins.client.json"
		}
	],
	"depends": {
		"fabricloader": ">=${loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}",
		"fabric-api": ">=${fabric}",
		"yet_another_config_lib_v3": ">=${yacl}"
	},
	"suggests": {
		"modmenu": ">={modmenu}"
	},
	"accessWidener": "neo-apoli.classtweaker"
}
