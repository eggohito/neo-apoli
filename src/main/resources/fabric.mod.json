{
	"schemaVersion": 1,
	"id": "neo-apoli",
	"version": "${version}",
	"name": "Neo-Apoli",
	"description": "A rewrite proof-of-concept of https://github.com/apace100/apoli",
	"authors": [
		"eggohito"
	],
	"contact": {
		"sources": "https://github.com/eggohito/neo-apoli"
	},
	"license": "CC0-1.0",
	"icon": "assets/neo-apoli/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.eggohito.neo_apoli.NeoApoli"
		],
		"client": [
			"io.github.eggohito.neo_apoli.NeoApoliClient"
		],
		"cardinal-components": [
			"io.github.eggohito.neo_apoli.component.NeoApoliEntityComponents"
		]
	},
	"mixins": [
		"neo-apoli.mixins.json",
		{
			"config": "neo-apoli.client.mixins.json",
			"environment": "client"
		}
	],
	"custom": {
		"cardinal-components": [
			"neo-apoli:powers"
		]
	},
	"depends": {
		"fabricloader": ">=0.16.13",
		"minecraft": "~1.21.5",
		"java": ">=21",
		"fabric-api": "*"
	}
}
